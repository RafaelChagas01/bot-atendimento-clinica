# copie para .env e preencha. O .env nunca vai para o Git.

# sem chave o bot responde pela busca local na base da clinica
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# gere com: python -c "import secrets; print(secrets.token_hex(32))"
STATE_SECRET=

# WhatsApp Cloud API (Meta for Developers). Sem esses quatro, o webhook fica desligado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

DATABASE_FILE=conversas.db
